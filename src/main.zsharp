import Workspace.lexer;

func version(): string { return "zsi 0.0.1 (launcher -> stage0)"; }

func usage(): void {
    echo "użycie:";
    echo "  zsi <plik.zs> [argumenty...]   uruchom program (źródło lub pakiet .zbc)";
    echo "  zsi --tokens <plik.zs>         zrzut tokenów (lekser Z#)";
    echo "  zsi --version | --help";
    echo "zmienne: ZSC0=<ścieżka do stage0> (domyślnie `zsc0` z PATH)";
}

func stage0(): string { return System.env("ZSC0") ?? "zsc0"; }

func dumpTokens(string $file): int {
    try {
        foreach (lexer.tokenize(File.read($file)) as $t) {
            echo $t["line"] . ":" . $t["col"] . "\t" . $t["kind"] . "\t" . $t["text"];
        }
    } catch (Exception $e) {
        eecho("zsi: " . $e->getMessage());
        return 1;
    }
    return 0;
}

func main(): int {
    $args = System.args();
    # opcje zsi kończą się na pierwszym argumencie nie zaczynającym się od `-`;
    # wszystko po nazwie skryptu należy do skryptu
    $i = 1;
    $tokens = false;
    while ($i < count($args) && starts_with($args[$i], "-")) {
        $a = $args[$i];
        if ($a === "--version") { echo version(); return 0; }
        else if ($a === "--help" || $a === "-h") { usage(); return 0; }
        else if ($a === "--tokens") { $tokens = true; }
        else { eecho("zsi: nieznana opcja " . $a); return 2; }
        $i++;
    }
    if ($i >= count($args)) { usage(); return 2; }
    $file = $args[$i];
    if (!File.exists($file)) { eecho("zsi: nie znaleziono pliku " . $file); return 1; }
    if ($tokens) { return dumpTokens($file); }
    $argv = [ends_with($file, ".zbc") ? "exec" : "run"];
    for ($j = $i; $j < count($args); $j++) { $argv[] = $args[$j]; }
    return Process.exec(stage0(), $argv);
}

exit(main());
